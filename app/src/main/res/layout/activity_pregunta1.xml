<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Pregunta1Activity">


<TextView
android:id="@+id/tvTitulo"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="CONSUMO DE AGUA POTABLE"
android:textSize="22sp"
android:textStyle="bold"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toTopOf="parent"
android:layout_marginTop="40dp" />

<TextView
android:id="@+id/tvDescripcion"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Ingrese el consumo de agua en m³:"
android:textSize="16sp"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/tvTitulo"
android:layout_marginStart="30dp"
android:layout_marginTop="40dp" />

<EditText
android:id="@+id/etConsumo"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:inputType="numberDecimal"
android:layout_marginStart="30dp"
android:layout_marginEnd="30dp"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/tvDescripcion" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="92dp"
        android:text="CALCULAR"
        app:layout_constraintEnd_toStartOf="@id/btnLimpiar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etConsumo" />

    <Button
        android:id="@+id/btnLimpiar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="80dp"
        android:text="LIMPIAR"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnCalcular"
        app:layout_constraintTop_toBottomOf="@id/etConsumo" />

    <TextView
android:id="@+id/tvResultadoTitulo"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="RESULTADO"
android:textSize="20sp"
android:textStyle="bold"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/btnCalcular"
android:layout_marginTop="40dp" />

<TextView
android:id="@+id/tvResultado"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:text=""
android:textSize="17sp"
android:padding="20dp"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/tvResultadoTitulo"
android:layout_marginStart="30dp"
android:layout_marginEnd="30dp"
android:layout_marginTop="15dp" />
</androidx.constraintlayout.widget.ConstraintLayout>